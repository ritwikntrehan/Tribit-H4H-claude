  "rules": [
    {
      "id": "DR-APPLICABILITY",
      "source": "applicability",
      "logic": "new_residential_units >= 3",
      "outcome": "development_review_likely",
      "confidence": "high",
      "caveat": "Check statutory exemptions and alternative ministerial pathways"
    },
    {
      "id": "DR-FILING",
      "source": "filing",
      "logic": "application_information_complete AND supporting_evidence_present",
      "outcome": "eligible_for_city_completeness_review",
      "confidence": "high",
      "caveat": "Director may request additional information; not a city completeness determination"
    },
    {
      "id": "DR-FINDING-1",
      "source": "findings",
      "logic": "public_health_safety_welfare",
      "outcome": "requires_evidence_and_city_judgment",
