    },
    {
      "id": "DR-FINDING-2",
      "source": "findings",
      "logic": "zoning_and_design_guidelines_compliance",
      "outcome": "requires_parcel_specific_analysis",
      "confidence": "city_decides"
    },
    {
      "id": "DR-FINDING-3",
      "source": "findings",
      "logic": "general_plan_and_specific_plan_consistency",
      "outcome": "requires_parcel_specific_analysis",
