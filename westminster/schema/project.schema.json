{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tribit-H4H Project Intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "jurisdiction",
    "property",
    "development",
    "contacts",
    "documents",
    "review"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "jurisdiction": {
      "const": "Westminster, CA"
    },
    "property": {
      "type": "object",
      "required": [
        "address",
        "apn",
        "zoning"
      ],
      "properties": {
        "address": {
          "$ref": "#/$defs/fact"
        },
        "apn": {
          "$ref": "#/$defs/fact"
        },
        "zoning": {
          "$ref": "#/$defs/fact"
        },
        "general_plan": {
          "$ref": "#/$defs/fact"
        },
        "lot_area_sqft": {
          "$ref": "#/$defs/fact"
        }
      }
    },
    "development": {
      "type": "object",
      "required": [
        "housing_type",
        "proposed_units",
        "ownership_model"
      ],
      "properties": {
        "housing_type": {
          "$ref": "#/$defs/fact"
        },
        "proposed_units": {
          "$ref": "#/$defs/fact"
        },
        "ownership_model": {
          "$ref": "#/$defs/fact"
        },
        "affordability": {
          "$ref": "#/$defs/fact"
        },
        "project_description": {
          "$ref": "#/$defs/fact"
        },
        "existing_units": {
          "$ref": "#/$defs/fact"
        }
      }
    },
    "contacts": {
      "type": "object",
      "properties": {
        "applicant": {
          "$ref": "#/$defs/party"
        },
        "owner": {
          "$ref": "#/$defs/party"
        },
        "agent": {
          "$ref": "#/$defs/party"
        },
        "architect": {
          "$ref": "#/$defs/party"
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "status": {
            "enum": [
              "missing",
              "uploaded",
              "needs_review",
              "verified"
            ]
          },
          "private_storage_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_filename": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "city_pathway_confirmed",
        "human_approved",
        "auto_submit"
      ],
      "properties": {
        "city_pathway_confirmed": {
          "type": "boolean"
        },
        "human_approved": {
          "type": "boolean"
        },
        "auto_submit": {
          "const": false
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "required": [
        "value",
        "status"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "status": {
          "enum": [
            "missing",
            "unverified",
            "document_extracted",
            "user_confirmed",
            "conflicting"
          ]
        },
        "source_document_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_page": {
          "type": [
            "integer",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "party": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/fact"
        },
        "email": {
          "$ref": "#/$defs/fact"
        },
        "phone": {
          "$ref": "#/$defs/fact"
        },
        "mailing_address": {
          "$ref": "#/$defs/fact"
        }
      }
    }
  }
}
